{
	"name": "@codeteam/skills",
	"version": "0.0.0",
	"private": true,
	"description": "codeteam curated skill catalog and allowlist resolver",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"manifest.yaml",
		"skills",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && shx cp manifest.yaml dist/manifest.yaml && shx cp -r skills dist/skills",
		"pretest": "npm run build",
		"test": "vitest --run"
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@codeteam/pi-adapter": "0.0.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "22.19.19",
		"shx": "0.3.4",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
